    "directory": "js/forcefield-sim"
  },
  "peerDependencies": {
    "forcefield-wasm": "^0.1.0"
  },
  "devDependencies": {
    "d3-force": "2.1.1",
    "forcefield-wasm": "^0.1.0"
  }
}
